<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>RiotFix</AssemblyName>
    <RootNamespace>RiotFix.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RiotFix.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <!-- Publish settings (used with: dotnet publish -r win-x64) -->
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is a Page so that Program.Main (not a generated Main) decides between GUI and the elevated helper. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\RiotFix.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiotFix.Core\RiotFix.Core.csproj" />
  </ItemGroup>
</Project>
