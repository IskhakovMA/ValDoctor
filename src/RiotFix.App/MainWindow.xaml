<Window x:Class="RiotFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiotFix"
        Icon="pack://application:,,,/RiotFix;component/Assets/RiotFix.ico"
        Width="520" Height="520" MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <!-- One screen, one main action: status, a short message and one prominent button.
       Everything technical is behind the small ⓘ button («Подробности»). -->
  <Grid x:Name="Root" Background="{DynamicResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="28,22,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="RiotFix" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Проверка подключения к Riot Games" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,1,0,0" />
      </StackPanel>
      <Button x:Name="DetailsButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE946;" VerticalAlignment="Top"
              Command="{Binding OpenDetailsCommand}" ToolTip="Подробности для поддержки" AutomationProperties.Name="Подробности" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel VerticalAlignment="Center" Margin="32,16,32,16" MaxWidth="420">

        <!-- Update notice: shown only when GitHub Releases has a newer version the user has not dismissed -->
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="14,10,8,10" Margin="0,0,0,20"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding UpdateHeadline}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding UpdateSummary}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Скачать" Command="{Binding DownloadUpdateCommand}"
                    VerticalAlignment="Center" Margin="12,0,10,0" ToolTip="Открыть страницу релиза на GitHub" />
            <Button Grid.Column="2" Command="{Binding DismissUpdateCommand}" VerticalAlignment="Center" Cursor="Hand"
                    ToolTip="Скрыть уведомление" AutomationProperties.Name="Скрыть уведомление" FocusVisualStyle="{StaticResource FocusRing}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" Padding="6">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <!-- Status -->
        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Style="{StaticResource ToneBadge}">
          <TextBlock Style="{StaticResource ToneGlyph}" FontSize="26" />
        </Border>
        <TextBlock Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,16,0,0" AutomationProperties.LiveSetting="Assertive" />
        <TextBlock Text="{Binding Body}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,6,0,0" LineHeight="20" />

        <StackPanel Margin="0,18,0,0" Width="220" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <ProgressBar Style="{StaticResource ThinProgress}" AutomationProperties.Name="Выполняется" />
          <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- The one main action -->
        <Grid Margin="0,24,0,0" HorizontalAlignment="Center" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
          <Button x:Name="PrimaryCheck" Style="{StaticResource HeroButton}" Content="{Binding CheckText}" Command="{Binding CheckCommand}"
                  IsDefault="True" Visibility="{Binding ShowCheckAsPrimary, Converter={StaticResource BoolToVisibility}}" />
          <Button x:Name="PrimaryFix" Style="{StaticResource HeroButton}" Content="Исправить подключение" Command="{Binding FixCommand}"
                  Visibility="{Binding FixReady, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Secondary actions: quiet links that never compete with the main button -->
        <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
          <Button Style="{StaticResource LinkButton}" Content="Проверить снова" Command="{Binding CheckCommand}" Margin="10,0"
                  Visibility="{Binding ShowRecheckLink, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource LinkButton}" Content="Остановить проверку" Command="{Binding CancelCommand}" Margin="10,0" IsCancel="True"
                  Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource LinkButton}" Content="Отменить изменения" Command="{Binding RevertCommand}" Margin="10,0"
                  ToolTip="Убрать изменения, которые RiotFix вносил раньше"
                  Visibility="{Binding ShowRevertLink, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="28,4,28,14">
      <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center">
        <Run Text="{Binding Version, Mode=OneWay}" />
        <Run Text=" · " />
        <Hyperlink Command="{Binding OpenRepositoryCommand}" Foreground="{DynamicResource AccentLink}">Исходный код</Hyperlink>
        <Run Text=" · Не связано с Riot Games" />
      </TextBlock>
    </Grid>
  </Grid>
</Window>
