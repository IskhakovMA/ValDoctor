<Window x:Class="RiotFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiotFix"
        Icon="pack://application:,,,/RiotFix;component/Assets/RiotFix.ico"
        Width="580" Height="660" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid x:Name="Root" Background="{DynamicResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="28,24,28,0">
      <TextBlock Text="RiotFix" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Диагностика подключения к сервисам Riot Games" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,20,0,0">
      <StackPanel Margin="28,0,28,8">

        <!-- Update notice: shown only when GitHub Releases has a newer version the user has not dismissed -->
        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="14,10,8,10" Margin="0,0,0,12"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding UpdateHeadline}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding UpdateSummary}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Скачать" Command="{Binding DownloadUpdateCommand}"
                    VerticalAlignment="Center" Margin="12,0,10,0" ToolTip="Открыть страницу релиза на GitHub" />
            <Button Grid.Column="2" Command="{Binding DismissUpdateCommand}" VerticalAlignment="Center" Cursor="Hand"
                    ToolTip="Скрыть уведомление" AutomationProperties.Name="Скрыть уведомление" FocusVisualStyle="{StaticResource FocusRing}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" Padding="6">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <!-- Status -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="20,18">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Style="{StaticResource ToneBadge}">
                <TextBlock Style="{StaticResource ToneGlyph}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{Binding Body}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20" />
              </StackPanel>
            </Grid>

            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
              <ProgressBar Style="{StaticResource ThinProgress}" AutomationProperties.Name="Выполняется" />
              <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Per-service summary -->
            <ItemsControl ItemsSource="{Binding Services}" Margin="0,14,0,0" Focusable="False"
                          Visibility="{Binding HasServices, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Style="{StaticResource ToneDot}" />
                      <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Style="{StaticResource ToneText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Details -->
        <Expander Header="Детали" Style="{StaticResource DetailsExpander}" Margin="0,16,0,8">
          <StackPanel>
            <TextBox Style="{StaticResource ReportBox}" Text="{Binding Details, Mode=OneWay}" AutomationProperties.Name="Отчёт о проверке" />
            <WrapPanel Margin="0,10,0,0">
              <Button Style="{StaticResource LinkButton}" Content="Скопировать отчёт" Command="{Binding CopyReportCommand}" Margin="0,0,18,4" />
              <Button Style="{StaticResource LinkButton}" Content="Открыть папку журналов" Command="{Binding OpenLogsCommand}" Margin="0,0,18,4" />
            </WrapPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0">
              <Run Text="Файл hosts:" /> <Run Text="{Binding HostsPath, Mode=OneWay}" />
              <LineBreak />
              <Run Text="Резервная копия (создаётся перед первым изменением):" /> <Run Text="{Binding BackupPath, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- Actions: pinned above the footer so the main button is always visible -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14,28,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="PrimaryCheck" Style="{StaticResource PrimaryButton}" Content="{Binding CheckText}" Command="{Binding CheckCommand}"
                    Margin="0,0,8,8" IsDefault="True"
                    Visibility="{Binding ShowCheckAsPrimary, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="PrimaryFix" Style="{StaticResource PrimaryButton}" Content="Исправить" Command="{Binding FixCommand}"
                    Margin="0,0,8,8"
                    Visibility="{Binding FixReady, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Проверить снова" Command="{Binding CheckCommand}"
                    Margin="0,0,8,8"
                    Visibility="{Binding FixReady, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Отмена" Command="{Binding CancelCommand}"
                    Margin="0,0,8,8" IsCancel="True"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>
          <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Отменить изменения" Command="{Binding RevertCommand}"
                  VerticalAlignment="Top" Margin="8,0,0,8"
                  ToolTip="Удалить записи RiotFix из файла hosts и вернуть сторонние строки, которые RiotFix закомментировал"
                  ToolTipService.ShowOnDisabled="True" />
        </Grid>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="28,4,28,14">
      <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap">
        <Run Text="{Binding Version, Mode=OneWay}" />
        <Run Text=" · " />
        <Hyperlink Command="{Binding OpenRepositoryCommand}" Foreground="{DynamicResource AccentLink}">Исходный код</Hyperlink>
        <Run Text=" · Не связано с Riot Games" />
      </TextBlock>
    </Grid>
  </Grid>
</Window>
