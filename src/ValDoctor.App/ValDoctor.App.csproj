<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ValDoctor</AssemblyName>
    <!-- Windows file properties: FileDescription comes from AssemblyTitle -->
    <AssemblyTitle>ValDoctor</AssemblyTitle>
    <Description>ValDoctor — проверка и исправление подключения к сервисам Riot Games</Description>
    <RootNamespace>ValDoctor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ValDoctor.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Security: the elevated helper inherits the user's environment (HKCU\Environment is user-writable).
         Ignore DOTNET_STARTUP_HOOKS so no assembly can be injected into it before Main. -->
    <StartupHookSupport>false</StartupHookSupport>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <!-- Publish settings (used with: dotnet publish -r win-x64) -->
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is a Page so that Program.Main (not a generated Main) decides between GUI and the elevated helper. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\ValDoctor.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValDoctor.Core\ValDoctor.Core.csproj" />
  </ItemGroup>
</Project>
