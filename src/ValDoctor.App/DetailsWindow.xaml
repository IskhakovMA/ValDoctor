<Window x:Class="ValDoctor.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ValDoctor — подробности"
        Icon="pack://application:,,,/ValDoctor;component/Assets/ValDoctor.ico"
        Width="640" Height="560" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid x:Name="Root" Background="{DynamicResource Bg}">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Подробности" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Технический отчёт о последней проверке. Он не содержит личных данных — его можно отправить в поддержку."
                 Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12" />
    </StackPanel>

    <TextBox Grid.Row="1" Style="{StaticResource ReportBox}" MaxHeight="Infinity" Text="{Binding Details, Mode=OneWay}"
             AutomationProperties.Name="Отчёт о проверке" />

    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
      <Button Style="{StaticResource LinkButton}" Content="Скопировать отчёт" Command="{Binding CopyReportCommand}" Margin="0,0,18,4" />
      <Button Style="{StaticResource LinkButton}" Content="Открыть папку журналов" Command="{Binding OpenLogsCommand}" Margin="0,0,18,4" />
    </WrapPanel>

    <TextBlock Grid.Row="3" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0">
      <Run Text="Файл hosts:" /> <Run Text="{Binding HostsPath, Mode=OneWay}" />
      <LineBreak />
      <Run Text="Резервная копия (создаётся перед первым изменением):" /> <Run Text="{Binding BackupPath, Mode=OneWay}" />
    </TextBlock>
  </Grid>
  </Grid>
</Window>
